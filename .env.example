PORT=3000
PUBLIC_BASE_URL=https://api.forexanalyzerpro.com
FRONTEND_URL=https://forexanalyzerpro.com
API_KEY=forexanalyzer-local-key

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
SUPABASE_SCHEMA=public
DB_WRITE_DEBOUNCE_MS=750

PRODUCT_LICENSE_MODE=free
FREE_TRIAL_DAYS=30
FREE_TRIAL_GRACE_DAYS=3
FREE_TRIAL_WARNING_DAYS=5
FREE_EA_URL=https://www.mql5.com/en/market/product/111375
PAID_EA_URL=https://www.mql5.com/en/market/product/182969
PAID_EA_BUILD_TOKEN=replace-with-the-same-token-inside-your-paid-ea
REFERRAL_BONUS_DAYS=7

# Support notifications through Resend.
# Create this key in Resend, verify your sending domain, then set these in Railway.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
SUPPORT_FROM_EMAIL=ForexAnalyzer Pro <support@forexanalyzerpro.com>
SUPPORT_ADMIN_EMAILS=ianchomba734@gmail.com
SUPPORT_NOTIFY_EMAIL=ianchomba734@gmail.com

# Keep false in production so every EA connection is tied to a user trial/license.
# Only set true temporarily while migrating old EAs that still use API_KEY.
ALLOW_LEGACY_EA_KEY=false

# Optional: enables Direct MT Login through MetaApi (no EA install).
# Create a MetaApi API token and add it in your hosting environment variables.
METAAPI_TOKEN=your-metaapi-token
METAAPI_PROVISIONING_URL=https://mt-provisioning-api-v1.agiliumtrade.agiliumtrade.ai
METAAPI_CLIENT_API_URL=https://mt-client-api-v1.new-york.agiliumtrade.agiliumtrade.ai
METAAPI_SYNC_INTERVAL_MS=15000
METAAPI_HISTORY_DAYS=180
METAAPI_HISTORY_LIMIT=1000
